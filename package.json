{
  "name": "pic-smaller",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Pic Smaller — super easy-to-use online image compression tool with purely local processing",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:preview": "tsc && vite build --mode preview",
    "preview": "vite preview",
    "lint": "eslint . --cache --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --no-error-on-unmatched-pattern --ignore-unknown src/**/*",
    "test": "vitest run",
    "clean": "node scripts/clean.cjs",
    "clean:all": "node scripts/clean.cjs --all",
    "wasm:build": "node scripts/build-wasm.cjs",
    "wasm:integrate": "node scripts/integrate-wasm.cjs",
    "wasm:full": "npm run wasm:build && npm run wasm:integrate"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@vercel/analytics": "^2.0.1",
    "antd": "^6.4.3",
    "classnames": "^2.5.1",
    "filesize": "^11.0.17",
    "get-user-locale": "^3.0.0",
    "history": "^5.3.0",
    "jszip": "^3.10.1",
    "mobx": "^6.16.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-responsive": "^10.0.1",
    "sprintf-js": "^1.1.3",
    "vconsole": "^3.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sprintf-js": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
